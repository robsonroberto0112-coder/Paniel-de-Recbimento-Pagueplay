        function render() {
          const container = document.getElementById("presentation-container");
          container.innerHTML = "";

          slidesMap.forEach((data, slideId) => {
            const slideElem = createSlideHTML(slideId, data);
            container.appendChild(slideElem);
          });
        }

        function updateState() {
          const slides = document.querySelectorAll(".slide");
          slides.forEach((slide) => slide.classList.remove("active"));

          const currentSlide = document.querySelector(
            `.slide[data-slide="${currentSlideIndex}"]`
          );
          if (currentSlide) {
            currentSlide.classList.add("active");

            const titleElem = currentSlide.querySelector(".slide-title");
            document.getElementById("current-slide-title").textContent =
              titleElem ? titleElem.textContent : "PAGUEPLAY";

            const revealItems = currentSlide.querySelectorAll(".reveal-item");
            revealItems.forEach((item) => {
              const step = parseInt(item.dataset.step, 10);
              if (step <= currentStepIndex) {
                item.classList.add("visible");
              } else {
                item.classList.remove("visible");
              }
            });
          }

          document.getElementById("current-slide-num").textContent = String(
            currentSlideIndex
          ).padStart(2, "0");
          const progressPct = (currentSlideIndex / (totalSlides - 1)) * 100;
          document.getElementById(
            "progress-bar"
          ).style.width = `${progressPct}%`;

          document.getElementById("btn-prev").disabled =
            currentSlideIndex === 0 && currentStepIndex === 0;
        }

        function nextStepOrSlide() {
          const currentSlide = document.querySelector(
            `.slide[data-slide="${currentSlideIndex}"]`
          );
          if (!currentSlide) return;

          const revealItems = currentSlide.querySelectorAll(".reveal-item");
          const maxSteps =
            revealItems.length > 0
              ? Math.max(
                  ...Array.from(revealItems).map((i) =>
                    parseInt(i.dataset.step, 10)
                  )
                )
              : 0;

          if (currentStepIndex < maxSteps) {
            currentStepIndex++;
            updateState();
          } else if (currentSlideIndex < totalSlides - 1) {
            currentSlideIndex++;
            currentStepIndex = 0;
            updateState();
          }
        }

        function prevStepOrSlide() {
          if (currentStepIndex > 0) {
            currentStepIndex--;
            updateState();
          } else if (currentSlideIndex > 0) {
            currentSlideIndex--;
            const prevSlide = document.querySelector(
              `.slide[data-slide="${currentSlideIndex}"]`
            );
            const revealItems = prevSlide.querySelectorAll(".reveal-item");
            currentStepIndex =
              revealItems.length > 0
                ? Math.max(
                    ...Array.from(revealItems).map((i) =>
                      parseInt(i.dataset.step, 10)
                    )
                  )
                : 0;
            updateState();
          }
        }

        function downloadFullPDF() {
          const exportContainer = document.createElement("div");
          exportContainer.className = "pdf-export-container";

          slidesMap.forEach((data, slideId) => {
            const slideElem = createSlideHTML(slideId, data);
            exportContainer.appendChild(slideElem);
          });

          document.body.appendChild(exportContainer);

          const opt = {
            margin: 0,
            filename: "Apresentacao_Completa_PaguePlay.pdf",
            image: { type: "jpeg", quality: 0.98 },
            html2canvas: {
              scale: 2,
              useCORS: true,
              backgroundColor: "#07090e",
            },
            jsPDF: { unit: "in", format: "letter", orientation: "landscape" },
          };

          html2pdf()
            .set(opt)
            .from(exportContainer)
            .save()
            .then(() => {
              document.body.removeChild(exportContainer);
            });
        }

        function setupEvents() {
          document
            .getElementById("btn-next")
            .addEventListener("click", nextStepOrSlide);
          document
            .getElementById("btn-prev")
            .addEventListener("click", prevStepOrSlide);

          document.addEventListener("keydown", (e) => {
            if (e.key === "ArrowRight" || e.key === " ") {
              e.preventDefault();
              nextStepOrSlide();
            } else if (e.key === "ArrowLeft") {
              e.preventDefault();
              prevStepOrSlide();
            }
          });

          document
            .getElementById("btn-fullscreen")
            .addEventListener("click", () => {
              if (!document.fullscreenElement) {
                document.documentElement
                  .requestFullscreen()
                  .catch((err) => console.log(err));
              } else {
                if (document.exitFullscreen) document.exitFullscreen();
              }
            });

          document
            .getElementById("btn-pdf")
            .addEventListener("click", downloadFullPDF);
        }

        organizeData();
        render();
        setupEvents();
        updateState();
      });
    </script>

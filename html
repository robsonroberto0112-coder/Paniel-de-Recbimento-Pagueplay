<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PaguePlay - Liderança Humanizada & Ações</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <!-- html2pdf.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
      :root {
        --bg-dark: #07090e;
        --bg-card: #121826;
        --accent-green: #00e676;
        --accent-blue: #00b0ff;
        --accent-purple: #7c4dff;
        --accent-red: #ff5252;
        --accent-gold: #ffd700;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --text-dark: #0f172a;
        --border-color: rgba(255, 255, 255, 0.08);
        --font-family: "Plus Jakarta Sans", sans-serif;
        --shadow-soft: 0 10px 30px rgba(0, 0, 0, 0.5);
        --gradient-brand: linear-gradient(135deg, #00e676 0%, #00b0ff 100%);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-family);
        background-color: var(--bg-dark);
        color: var(--text-main);
        overflow: hidden;
        height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* BARRA SUPERIOR */
      .navbar {
        height: 60px;
        background: rgba(11, 15, 25, 0.9);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        z-index: 100;
      }

      .nav-brand {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .nav-logo {
        height: 28px;
        filter: drop-shadow(0 0 8px rgba(0, 230, 118, 0.2));
      }

      .nav-divider {
        color: var(--border-color);
        font-weight: 300;
      }

      .nav-title {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--text-muted);
      }

      .nav-controls {
        display: flex;
        gap: 12px;
      }

      .btn-control {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .btn-control:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: var(--accent-green);
        color: #fff;
        transform: translateY(-1px);
      }

      /* ÁREA DA APRESENTAÇÃO */
      .presentation-viewport {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        position: relative;
        overflow: hidden;
      }

      .presentation-container {
        width: 100%;
        max-width: 1366px;
        aspect-ratio: 16 / 9;
        background: var(--bg-dark);
        background-image: radial-gradient(
            circle at 10% 10%,
            rgba(0, 230, 118, 0.05) 0%,
            transparent 40%
          ),
          radial-gradient(
            circle at 90% 90%,
            rgba(0, 176, 255, 0.05) 0%,
            transparent 40%
          );
        border-radius: 16px;
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-soft);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }

      /* SLIDES */
      .slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        padding: 40px 60px;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.4s ease, transform 0.4s ease;
        transform: scale(0.98);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .slide.active {
        opacity: 1;
        visibility: visible;
        transform: scale(1);
      }

      .slide-header {
        margin-bottom: 20px;
      }

      .slide-title {
        font-size: 2.2rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-transform: uppercase;
      }

      .slide-subtitle {
        font-size: 1.05rem;
        color: var(--accent-green);
        font-weight: 600;
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .slide-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
      }

      /* REVELAÇÃO PROGRESSIVA */
      .reveal-item {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.4s ease, transform 0.4s ease;
      }

      .reveal-item.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* CAPA E IMPACTO */
      .slide-capa,
      .slide-impacto {
        justify-content: center;
        align-items: center;
        text-align: center;
        background: radial-gradient(
          circle at center,
          rgba(0, 230, 118, 0.1) 0%,
          transparent 70%
        );
      }

      .capa-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
      }

      .capa-logo {
        height: 75px;
        filter: drop-shadow(0 0 25px rgba(0, 230, 118, 0.4));
      }

      .capa-title-box h1 {
        font-size: 3.2rem;
        font-weight: 800;
        letter-spacing: -1px;
        background: linear-gradient(135deg, #ffffff 30%, #00e676 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 12px;
      }

      .capa-subtitle {
        font-size: 1.3rem;
        color: var(--text-muted);
        font-weight: 500;
      }

      .capa-datetime {
        display: flex;
        gap: 20px;
        padding: 10px 24px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border-color);
        border-radius: 50px;
        font-size: 0.9rem;
        color: var(--accent-green);
        font-weight: 600;
      }

      .impacto-phrase {
        font-size: 3.5rem;
        font-weight: 800;
        line-height: 1.2;
        background: linear-gradient(
          135deg,
          #ffffff 0%,
          var(--accent-green) 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-transform: uppercase;
        max-width: 900px;
      }

      /* TABELAS DE METAS E REGRAS */
      .metas-tables-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 16px;
      }

      .meta-table-box {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 16px;
      }

      .meta-table-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--accent-green);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        text-transform: uppercase;
      }

      .styled-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
      }

      .styled-table th,
      .styled-table td {
        padding: 8px 10px;
        text-align: center;
        border-bottom: 1px solid var(--border-color);
      }

      .styled-table th {
        background: rgba(255, 255, 255, 0.05);
        color: var(--accent-blue);
        font-weight: 700;
      }

      .styled-table tr:last-child td {
        border-bottom: none;
      }

      /* DINÂMICA DO MÊS (PERCENTUAL E PRÊMIOS) */
      .dinamica-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
        margin: 16px 0;
      }

      .dinamica-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 16px 12px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
      }

      .dinamica-card.gold {
        border-color: var(--accent-gold);
        background: linear-gradient(
          180deg,
          rgba(255, 215, 0, 0.15) 0%,
          rgba(18, 24, 38, 1) 100%
        );
      }

      .dinamica-rank {
        font-size: 1.1rem;
        font-weight: 800;
        margin-bottom: 6px;
      }

      .dinamica-icon {
        font-size: 2.5rem;
        margin: 10px 0;
      }

      .dinamica-prize {
        font-size: 0.9rem;
        font-weight: 700;
        color: #fff;
      }

      /* REAJUSTE DE LIDERANÇA VISUAL */
      .reajuste-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }

      .reajuste-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .cargo-title {
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: 1px;
        color: var(--accent-blue);
        text-transform: uppercase;
        margin-bottom: 18px;
      }

      .val-step-box {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 10px;
      }

      .val-step-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: var(--text-muted);
        font-weight: 700;
      }

      .val-step-num {
        font-size: 1.3rem;
        font-weight: 800;
        color: #94a3b8;
      }

      .val-arrow-down {
        color: var(--accent-green);
        font-size: 1.1rem;
        margin: 4px 0;
      }

      .reajuste-badge {
        background: rgba(0, 230, 118, 0.15);
        border: 1px solid var(--accent-green);
        color: var(--accent-green);
        font-size: 0.95rem;
        font-weight: 800;
        padding: 6px 16px;
        border-radius: 20px;
        margin: 4px 0;
      }

      .val-step-box.novo {
        background: linear-gradient(
          135deg,
          rgba(0, 230, 118, 0.15) 0%,
          rgba(0, 176, 255, 0.15) 100%
        );
        border: 2px solid var(--accent-green);
        box-shadow: 0 0 20px rgba(0, 230, 118, 0.2);
      }

      .val-step-box.novo .val-step-num {
        font-size: 1.8rem;
        color: #fff;
      }

      /* DEMAIS SLIDES E COMPONENTES */
      .pdi-steps-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin: 20px 0;
      }

      .pdi-step-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 24px 16px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }

      .pdi-step-card i {
        font-size: 2.2rem;
        color: var(--accent-green);
      }

      .pdi-step-title {
        font-size: 1.2rem;
        font-weight: 800;
        color: #fff;
      }

      .topics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 20px;
      }
      .topic-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 18px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
      }
      .topic-card i {
        font-size: 1.4rem;
        color: var(--accent-green);
        background: rgba(0, 230, 118, 0.1);
        padding: 10px;
        border-radius: 10px;
      }

      .provocacao-box {
        background: linear-gradient(
          135deg,
          rgba(0, 230, 118, 0.15) 0%,
          rgba(0, 176, 255, 0.1) 100%
        );
        border: 1px solid var(--accent-green);
        border-radius: 14px;
        padding: 20px 28px;
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .badge-valendo {
        background: var(--accent-red);
        color: #fff;
        padding: 6px 16px;
        border-radius: 20px;
        font-weight: 800;
        font-size: 0.85rem;
        display: inline-block;
        margin-bottom: 12px;
        animation: pulse 2s infinite;
      }
      @keyframes pulse {
        0% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.05);
        }
        100% {
          transform: scale(1);
        }
      }

      .action-flow-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 20px;
      }
      .flow-card-box {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 24px;
      }
      .flow-card-box h3 {
        font-size: 1.1rem;
        color: var(--accent-gold);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .flow-steps {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .flow-step-item {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 14px;
        text-align: center;
        flex: 1;
      }
      .flow-step-item i {
        font-size: 1.8rem;
        color: var(--accent-green);
        margin-bottom: 8px;
      }
      .flow-arrow {
        color: var(--text-muted);
        font-size: 1.2rem;
        padding: 0 8px;
      }

      .items-table-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
      }
      .item-rule-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 20px;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .item-rule-card i {
        font-size: 2.2rem;
        color: var(--accent-blue);
        margin-bottom: 12px;
      }
      .item-rule-title {
        font-weight: 800;
        font-size: 1.1rem;
        margin-bottom: 8px;
      }
      .item-rule-quant {
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-bottom: 14px;
      }
      .item-rule-rewards {
        background: rgba(255, 255, 255, 0.04);
        border-radius: 8px;
        padding: 10px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-weight: 700;
        font-size: 0.88rem;
      }

      .questions-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        margin-bottom: 18px;
      }
      .question-card {
        background: var(--bg-card);
        border-left: 4px solid var(--accent-blue);
        border-radius: 10px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 14px;
        font-weight: 600;
      }
      .objective-box {
        background: rgba(255, 255, 255, 0.03);
        border: 1px dashed var(--border-color);
        border-radius: 12px;
        padding: 14px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .conclusion-quote {
        background: rgba(0, 230, 118, 0.08);
        border-radius: 12px;
        padding: 16px;
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
        text-align: center;
        border: 1px solid rgba(0, 230, 118, 0.3);
      }

      .split-blocks {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
      }
      .block-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .block-card h3 {
        font-size: 1.15rem;
        color: var(--accent-green);
        margin-bottom: 16px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 10px;
      }
      .block-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .block-list li {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
      }

      .period-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 16px;
      }
      .period-card {
        background: var(--bg-card);
        border-radius: 14px;
        padding: 20px;
        border-top: 4px solid var(--accent-green);
      }
      .period-card.tarde {
        border-top-color: var(--accent-blue);
      }

      .pilares-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
      }
      .pilar-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .pilar-header {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--accent-green);
        margin-bottom: 8px;
      }

      .whatsapp-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin: 16px 0;
      }

      .wa-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 20px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
      }

      .wa-card i {
        font-size: 2rem;
        color: #25d366;
      }

      .wa-title {
        font-size: 1rem;
        font-weight: 800;
        color: #fff;
      }

      .combina-flow {
        display: flex;
        align-items: center;
        justify-content: space-around;
        gap: 20px;
        margin-top: 10px;
      }

      .combina-box {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 40px 30px;
        flex: 1;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      .combina-box.highlight {
        border-color: var(--accent-green);
        background: linear-gradient(
          135deg,
          rgba(0, 230, 118, 0.15) 0%,
          rgba(18, 24, 38, 1) 100%
        );
        box-shadow: 0 0 30px rgba(0, 230, 118, 0.2);
      }

      .combina-icon {
        font-size: 4rem;
        margin-bottom: 20px;
      }

      .combina-text {
        font-size: 1.8rem;
        font-weight: 800;
        color: #fff;
      }

      .combina-box.highlight .combina-text {
        font-size: 2.2rem;
        color: var(--accent-green);
      }

      /* BARRA INFERIOR */
      .footer-bar {
        height: 65px;
        background: rgba(11, 15, 25, 0.95);
        border-top: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 0 24px 10px 24px;
      }

      .progress-container {
        width: 100%;
        height: 4px;
        background: rgba(255, 255, 255, 0.08);
      }
      .progress-bar {
        height: 100%;
        width: 0%;
        background: var(--gradient-brand);
        transition: width 0.3s ease;
      }
      .footer-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 8px;
      }
      .slide-indicator {
        font-size: 0.95rem;
        font-weight: 800;
        color: var(--accent-green);
      }
      .nav-buttons {
        display: flex;
        gap: 12px;
      }
      .btn-nav {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 8px 18px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .btn-nav:hover:not(:disabled) {
        background: var(--accent-green);
        color: var(--text-dark);
      }
      .btn-nav:disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }

      /* SUPORTE PDF COMPLETO */
      .pdf-export-container {
        width: 1366px;
        background: #07090e;
        color: #f8fafc;
      }
      .pdf-export-container .slide {
        position: relative !important;
        opacity: 1 !important;
        visibility: visible !important;
        transform: none !important;
        page-break-after: always;
        height: 768px !important;
        margin-bottom: 0;
      }
      .pdf-export-container .reveal-item {
        opacity: 1 !important;
        transform: none !important;
      }

      @media (max-width: 1024px) {
        .presentation-container {
          aspect-ratio: auto;
          height: 100%;
        }
        .slide {
          padding: 20px;
        }
        .reajuste-grid,
        .items-table-grid,
        .topics-grid,
        .questions-container,
        .pilares-grid,
        .combina-flow,
